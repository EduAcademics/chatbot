# Frontend (Vite) – copy to .env for local dev; on AWS Amplify set the same keys under Environment variables.

# Required for API calls (your chatbotApi / Docker backend URL)
VITE_API_BASE_URL=http://localhost:8000
# Optional aliases some builds use:
# VITE_LIVE_URL=
# VITE_LOCAL_URL=

# WebSocket base URL (e.g. speech) — wss:// in production
VITE_WS_BASE_URL=ws://localhost:8000

# ERP API (course progress, class sections, file previews). No default in app code — set in Amplify.
VITE_ERP_API_BASE_URL=

# Sent on AI requests as x-academic-session / x-branch-token (URL query can override via authStorage)
VITE_ACADEMIC_SESSION=
VITE_BRANCH_TOKEN=

# WebRTC / Pipecat bot
VITE_BOT_START_URL=
VITE_BOT_START_PUBLIC_API_KEY=

# ICE servers — only used if set (no built-in STUN/TURN hosts)
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Translation feature (non-Vite; if your build reads it)
TRANSLATOR=false
