# Frontend Environment Variables
# Copy this file to .env and update with your values

# Backend API URL (chatbotApi)
VITE_API_BASE_URL=http://localhost:8000
# Or use VITE_LIVE_URL / VITE_LOCAL_URL for environment-specific URLs

# WebSocket base URL (e.g. for speech-to-text)
VITE_WS_BASE_URL=ws://localhost:8000

# ERP API base URL (course progress, class sections)
VITE_ERP_API_BASE_URL=https://api.eduacademics.com

# Voice transport: livekit (recommended) | webrtc (legacy Pipecat SmallWebRTC)
VITE_VOICE_TRANSPORT=livekit
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Legacy WebRTC / Pipecat bot (only when VITE_VOICE_TRANSPORT=webrtc)
VITE_BOT_START_URL=http://localhost:7860/start
VITE_BOT_START_PUBLIC_API_KEY=

# ICE servers for WebRTC (optional – defaults used if not set)
# VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=turn:aiapi.eduacademics.com:3478
# VITE_TURN_USERNAME=webrtc
# VITE_TURN_CREDENTIAL=webrtcpass

# Translation feature (true/false)
TRANSLATOR=false
